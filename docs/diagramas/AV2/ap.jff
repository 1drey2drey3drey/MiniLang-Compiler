<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>pda</type>
	<automaton>
		<state id="0" name="q0">
			<x>80.0</x>
			<y>220.0</y>
			<label>Aguarda cabeçalho do programa ('p')</label>
			<initial />
		</state>
		<state id="1" name="q1">
			<x>200.0</x>
			<y>220.0</y>
			<label>Aguarda abertura do escopo principal ('{')</label>
		</state>
		<state id="2" name="q2">
			<x>340.0</x>
			<y>220.0</y>
			<label>Valida blocos '{...}' e expressões '(...)' aninhados via pilha</label>
		</state>
		<state id="3" name="q3">
			<x>500.0</x>
			<y>220.0</y>
			<label>Escopo principal fechado (topo Z); aguarda separador '#'</label>
		</state>
		<state id="4" name="q4">
			<x>630.0</x>
			<y>220.0</y>
			<label>Aguarda o 1º tipo da assinatura de função ('i' ou 's')</label>
		</state>
		<state id="5" name="q5">
			<x>770.0</x>
			<y>220.0</y>
			<label>Lê demais tipos da assinatura ('i'/'s') ou separador ':'</label>
		</state>
		<state id="6" name="q6">
			<x>910.0</x>
			<y>220.0</y>
			<label>Aguarda o 1º tipo dos argumentos na chamada ('i' ou 's')</label>
		</state>
		<state id="7" name="q7">
			<x>1050.0</x>
			<y>220.0</y>
			<label>Lê demais tipos da chamada ('i'/'s') ou terminador ';'</label>
		</state>
		<state id="8" name="q8">
			<x>1190.0</x>
			<y>220.0</y>
			<label>Estado final — sintaxe válida (entrada integralmente consumida)</label>
			<final />
		</state>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>p</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>{</read>
			<pop>Z</pop>
			<push>{Z</push>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>{</read>
			<pop>{</pop>
			<push>{{</push>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>{</read>
			<pop>(</pop>
			<push>{(</push>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>(</read>
			<pop>{</pop>
			<push>({</push>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>(</read>
			<pop>(</pop>
			<push>((</push>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>}</read>
			<pop>{</pop>
			<push />
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>)</read>
			<pop>(</pop>
			<push />
		</transition>
		<transition>
			<from>2</from>
			<to>3</to>
			<read />
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>3</from>
			<to>4</to>
			<read>#</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>4</from>
			<to>5</to>
			<read>i</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>4</from>
			<to>5</to>
			<read>s</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>5</from>
			<to>5</to>
			<read>i</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>5</from>
			<to>5</to>
			<read>s</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>5</from>
			<to>6</to>
			<read>:</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>6</from>
			<to>7</to>
			<read>i</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>6</from>
			<to>7</to>
			<read>s</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>7</from>
			<to>7</to>
			<read>i</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>7</from>
			<to>7</to>
			<read>s</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>7</from>
			<to>8</to>
			<read>;</read>
			<pop>Z</pop>
			<push>Z</push>
